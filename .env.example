# Local PostgreSQL user for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Backend host port.
BACKEND_PORT=8080

# Frontend host port.
FRONTEND_PORT=3000

# Browser-visible backend origin for frontend API calls.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional local image repository prefix.
IMAGE_REPO=local

# Optional local image tag.
IMAGE_TAG=dev
